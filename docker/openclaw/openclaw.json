{
  "gateway": {
    "port": 18789,
    "bind": "custom",
    "customBindHost": "0.0.0.0",
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "models": {
    "mode": "replace",
    "providers": {
      "yashigani": {
        "baseUrl": "http://gateway:8081/v1",
        "apiKey": "__YASHIGANI_INTERNAL_BEARER__",
        "api": "openai-completions",
        "models": [
          {
            "id": "qwen2.5:3b",
            "name": "Qwen 2.5 3B (via Yashigani)",
            "contextWindow": 32768,
            "maxTokens": 4096
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": "yashigani/qwen2.5:3b"
    }
  },
  "egress": {
    "slack": {
      "apiBaseUrl": "https://caddy:18790/slack",
      "hooksBaseUrl": "https://caddy:18790/slack-hooks"
    },
    "telegram": {
      "apiBaseUrl": "https://caddy:18790/telegram"
    },
    "tls": {
      "certFile": "/etc/openclaw/tls/client.crt",
      "keyFile": "/etc/openclaw/tls/client.key"
    }
  }
}
