# v4.1 unified-sidecar Phase 2a — egress-forwarder config for system: openclaw (tenant: default)
# Container: egress-openclaw — the ONLY holder of this system's SVID mount.
# Listener is plain HTTP by design (T2) and reachable ONLY on the 2-member
# egress ringfence ringfence_openclaw_eg (system + forwarder — §2.6).
# NO CADDY_INTERNAL_HMAC in this config (synthesis must-fix #2).
{
    admin off
    auto_https off
    log {
        output stderr
        format json
    }
}

:9400 {
    # Outbound body cap — matches the :18790 gateway cap (ASVS 4.1.7).
    request_body {
        max_size 10MB
    }

    # Liveness only (config loaded + listener up). Serviceability of the
    # full egress path (leaf → :18790 → /egress/eval) is proven by the
    # Phase-2b live acceptance gate (design §8 item 4, Laura co-sign).
    handle /healthz {
        respond "ok" 200
    }

    # ── slack — openclaw /slack/* → caddy:18790/slack/* → /egress/eval ──
    # Final delivery target (enforced at the :18790 deliver handles): slack.com
    handle /slack/* {
        # Header hygiene: the wrapped system must not smuggle identity or
        # Layer-B markers — caddy:18790 re-stamps from the VERIFIED peer
        # cert anyway (forge-proof); this strip is belt-and-suspenders.
        request_header -X-SPIFFE-ID
        request_header -X-Caddy-Verified-Secret
        request_header -X-Yashigani-Verified-Spiffe
        reverse_proxy https://caddy:18790 {
            transport http {
                tls
                tls_trust_pool file /run/secrets/svid/default/openclaw/ca.crt
                tls_client_auth /run/secrets/svid/default/openclaw/client.crt /run/secrets/svid/default/openclaw/client.key
                tls_server_name caddy
                max_conns_per_host 64
            }
        }
    }

    # ── slack-hooks — openclaw /slack-hooks/* → caddy:18790/slack-hooks/* → /egress/eval ──
    # Final delivery target (enforced at the :18790 deliver handles): hooks.slack.com
