# Yashigani inference engine — ROCm (AMD) backend
# Lean per-backend image. Honesty note (build manifest): ROCm runtime userspace
# (rocBLAS/Tensile kernel blobs) is inherently large — "lean" here means lean relative to
# the fat GGML_BACKEND_DL multi-backend image (~8GB), not sub-1GB.
#
# OFFLINE-AUTHORED (2026-07-22, Captain). FROM digests are PLACEHOLDERS — resolve with
# scripts/resolve-and-pin-digests.sh before any live build.

FROM rocm/dev-ubuntu-24.04:6.2@sha256:PLACEHOLDER-RESOLVE-AT-BUILD-TIME AS builder

ARG LLAMA_CPP_TAG=PIN-ME
ARG LLAMA_CPP_COMMIT_SHA=PIN-ME
ARG AMDGPU_TARGETS="gfx1030;gfx1100;gfx1101"
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

RUN apt-get update \
    && apt-get -y --no-install-recommends install \
        git ca-certificates cmake build-essential ninja-build \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN git clone --depth 1 --branch "${LLAMA_CPP_TAG}" https://github.com/ggml-org/llama.cpp.git src \
    && test "$(git -C src rev-parse HEAD)" = "${LLAMA_CPP_COMMIT_SHA}" || \
        { echo "FATAL: checked-out commit does not match pinned LLAMA_CPP_COMMIT_SHA — refusing to build" >&2; exit 1; }

WORKDIR /build/src
RUN cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DGGML_NATIVE=OFF \
        -DGGML_HIP=ON \
        -DAMDGPU_TARGETS="${AMDGPU_TARGETS}" \
        -DCMAKE_C_COMPILER=/opt/rocm/llvm/bin/clang \
        -DCMAKE_CXX_COMPILER=/opt/rocm/llvm/bin/clang++ \
        -DLLAMA_CURL=OFF \
        -DBUILD_SHARED_LIBS=ON \
    && cmake --build build --config Release -j"$(nproc)" --target llama-server

FROM python:3.14.5-slim@sha256:7a500125bc50693f2214e842a621440a1b1b9cbb2188f74ab045d29ed2ea5856 AS wheel-builder
WORKDIR /wheel
COPY infer/pyproject.toml ./
COPY infer/src/ ./src/
RUN pip install --no-cache-dir --upgrade "pip==26.0.1" build \
    && python -m build --wheel --outdir /dist

# Runtime: same ROCm dev image family (no slim ROCm runtime-only image is published
# upstream) — we strip build tooling (compiler, git, headers) in a second layer instead,
# which is the honest lean-as-achievable answer for this backend.
FROM rocm/dev-ubuntu-24.04:6.2@sha256:PLACEHOLDER-RESOLVE-AT-BUILD-TIME AS runtime

RUN groupadd --gid 1002 yashigani-infer \
    && useradd --uid 1002 --gid 1002 --no-create-home --shell /bin/false yashigani-infer \
    && usermod -aG video,render yashigani-infer

# Strip the build/compiler toolchain the dev image ships, keeping only the ROCm runtime
# userspace (rocblas/hipblas/rocm-core) llama-server links against.
RUN apt-get update \
    && apt-get -y --purge remove '*llvm*' '*clang*' '*rocm-dev*' '*hip-dev*' cmake ninja-build build-essential git 2>/dev/null || true \
    && apt-get -y autoremove \
    && apt-get -y --no-install-recommends install python3.12-minimal rocm-smi-lib \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /build/src/build/bin/llama-server /usr/local/bin/llama-server
COPY --from=builder /build/src/build/bin/*.so /usr/local/lib/
RUN ldconfig
COPY --from=wheel-builder /dist/*.whl /tmp/
RUN pip3 install --no-cache-dir --break-system-packages /tmp/*.whl \
    && rm -f /tmp/*.whl

COPY infer/deploy/docker/entrypoint/infer-entrypoint.sh /usr/local/bin/infer-entrypoint.sh
COPY infer/deploy/gpu/healthcheck-gpu-engaged.sh /usr/local/bin/healthcheck-gpu-engaged.sh
RUN chmod 0555 /usr/local/bin/infer-entrypoint.sh /usr/local/bin/llama-server /usr/local/bin/healthcheck-gpu-engaged.sh \
    && mkdir -p /data/blobs /data/scratch \
    && chown -R yashigani-infer:yashigani-infer /data

USER yashigani-infer
EXPOSE 8000
ENV YSG_INFER_BACKEND=rocm \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONNOUSERSITE=1

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD /usr/local/bin/infer-entrypoint.sh --healthcheck || exit 1

ARG GIT_SHA=dev
LABEL org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.licenses="Apache-2.0 AND MIT" \
      yashigani.infer.backend="rocm"

ENTRYPOINT ["/usr/local/bin/infer-entrypoint.sh"]
