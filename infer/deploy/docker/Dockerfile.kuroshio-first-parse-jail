# Yashigani inference engine — C1 first-parse jail image.
#
# RED-COUNCIL C1 / Captain finding #1's sibling: "a distinct ephemeral seccomp-strict,
# network=none, torn-down step that performs the FIRST GGUF parse of an untrusted model,
# separate from the serving ring-fence." This image contains ONLY: Python + the existing
# pure-Python, bounds-checked GGUF header parser already shipped in kuroshio
# (src/kuroshio/gguf/header.py, gguf/quant_types.py) — vendored in at build time via
# a normal COPY from the same source tree. No new parsing logic is authored here; this is
# packaging Tom's existing defensive parser into an isolated, throwaway process boundary,
# per the containment/hooks.py FirstParseJailHook seam contract:
#   FirstParseJailHook = Callable[[bytes], bytes]   # arg/return: raw header bytes
#
# Invocation contract (CLI, stdin/stdout — see entrypoint/first-parse-jail-entrypoint.sh):
#   input:  raw GGUF header bytes on stdin (first N bytes of the untrusted file, the
#           caller decides N — this image does not fetch/download anything itself, no
#           network capability exists in the container to do so)
#   output: JSON on stdout: {"ok": true, "header": {...}} on successful bounded parse,
#           or {"ok": false, "error": "<class>"} — NEVER a raw traceback (avoids leaking
#           internal paths/memory-layout info to whatever invoked the jail).
#   exit code: 0 on structurally-valid parse (ok:true or ok:false-clean-refusal), non-zero
#           only on a genuine crash (the invoking supervisor must treat a non-zero exit as
#           "this model's header could not be safely characterised — quarantine, do not
#           promote to serving" per the OnboardingGateHook seam).
#
# This container is spawned ONE-SHOT per untrusted model's first parse, torn down
# immediately after (--rm on compose invocation / TTL Job on k8s) — see
# docker/docker-compose.kuroshio.yml (invoke-first-parse-jail) and
# helm/yashigani-kuroshio/templates/job-first-parse-jail.yaml. It NEVER stays resident and
# NEVER shares a container/process with the serving ring-fence's llama-server instances.
#
# OFFLINE-AUTHORED (2026-07-22, Captain). FROM digest is a PLACEHOLDER.

FROM python:3.14.5-slim@sha256:7a500125bc50693f2214e842a621440a1b1b9cbb2188f74ab045d29ed2ea5856 AS runtime

RUN groupadd --gid 1003 yashigani-parsejail \
    && useradd --uid 1003 --gid 1003 --no-create-home --shell /bin/false yashigani-parsejail

WORKDIR /app
# Vendor ONLY the pure-Python GGUF header parser package — not the whole kuroshio
# wheel (this jail must not be able to spawn processes, reach the blob store, or touch the
# network; shipping the full control-plane package would be a bigger attack surface than
# the parser it's meant to sandbox). Namespace preserved (kuroshio.gguf.*) because
# gguf/header.py does `from kuroshio.gguf.quant_types import ...` — an absolute
# intra-package import, not relative — so the parent package path must exist on disk.
RUN mkdir -p ./kuroshio
COPY infer/src/kuroshio/gguf/ ./kuroshio/gguf/
RUN touch ./kuroshio/__init__.py
COPY infer/deploy/docker/entrypoint/first-parse-jail-entrypoint.sh /usr/local/bin/first-parse-jail-entrypoint.sh
RUN chmod 0555 /usr/local/bin/first-parse-jail-entrypoint.sh

USER yashigani-parsejail
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONNOUSERSITE=1 \
    PYTHONPATH=/app

ARG GIT_SHA=dev
LABEL org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      yashigani.kuroshio.role="first-parse-jail"

ENTRYPOINT ["/usr/local/bin/first-parse-jail-entrypoint.sh"]
