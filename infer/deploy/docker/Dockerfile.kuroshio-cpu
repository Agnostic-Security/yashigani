# Yashigani inference engine — CPU backend (multi-arch: amd64 + arm64)
# Universal fallback (platform doc §3/§4.3); also the Mac-in-VM / M-k8s dev-cell image.
# Build with buildx: docker buildx build --platform linux/amd64,linux/arm64 -f Dockerfile.kuroshio-cpu ...
#
# OFFLINE-AUTHORED (2026-07-22, Captain). FROM digest is a PLACEHOLDER — resolve with
# scripts/resolve-and-pin-digests.sh before any live build.

# ---------------------------------------------------------------------------
# ARTIFACT STAGE — consume the VERIFIED upstream prebuilt (D25/D26).
#
# This stage used to clone llama.cpp and run cmake. It no longer does, and the
# reason is not convenience: Mac cannot compile a Linux binary and Linux cannot
# compile a Metal one, so a build-per-platform meant two sourcing models, two
# trust roots and two CVE-response paths for ONE component — the sixth
# divergence D26 exists to prevent, and one that would have stayed invisible
# until someone asked which llama.cpp a given box was running.
#
# The artifact is fetched and verified OUTSIDE the image by
# `infer/deploy/scripts/fetch-llama-server.sh`, which checks:
#   - the release asset digest against a recorded pin (a tag alone is not a
#     pin; GitHub release assets can be replaced in place)
#   - the Sigstore build-provenance attestation, proving upstream CI built it
#     from the tagged source — something the from-source path could never
#     prove about its own build host, and which Linux did not have at all
#     while it floated on `:local` tags
#   - the expected backend library is present
#   - the binary does not link libcurl, so the engine cannot fetch models
#     itself (D16)
#
# Verification happens outside the image on purpose: it needs `gh` for the
# attestation and network for the registry, neither of which belongs in a
# build layer. The image consumes an artifact that has ALREADY been proven.
#
# KUROSHIO_ARTIFACT_DIR is the fetch script's OUT_DIR, relative to the build
# context. Building without running the fetch first fails at COPY — loudly,
# which is the correct direction for a missing provenance step.
ARG KUROSHIO_ARTIFACT_DIR=infer/deploy/artifacts/ubuntu-x64
FROM debian:trixie-slim@sha256:PLACEHOLDER-RESOLVE-AT-BUILD-TIME AS artifact
ARG KUROSHIO_ARTIFACT_DIR
WORKDIR /artifact
COPY ${KUROSHIO_ARTIFACT_DIR}/ ./
# Fail closed if the manifest the fetch script writes is absent or says the
# artifact was never provenance-checked. An unverified binary must not reach a
# runtime image just because the file happened to be in the right directory.
RUN test -f llama-server || { echo "FATAL: no llama-server in ${KUROSHIO_ARTIFACT_DIR} — run infer/deploy/scripts/fetch-llama-server.sh first" >&2; exit 1; } \
    && test -f llama-server.manifest.json || { echo "FATAL: no artifact manifest — the fetch script did not produce this, refusing" >&2; exit 1; } \
    && grep -q '"build_provenance_attested": true' llama-server.manifest.json || \
       { echo "FATAL: artifact manifest does not record a verified build-provenance attestation — refusing" >&2; exit 1; } \
    && chmod 0555 llama-server

FROM python:3.14.5-slim@sha256:7a500125bc50693f2214e842a621440a1b1b9cbb2188f74ab045d29ed2ea5856 AS wheel-builder
WORKDIR /wheel
COPY infer/pyproject.toml ./
COPY infer/src/ ./src/
RUN pip install --no-cache-dir --upgrade "pip==26.0.1" build \
    && python -m build --wheel --outdir /dist

FROM debian:trixie-slim@sha256:PLACEHOLDER-RESOLVE-AT-BUILD-TIME AS runtime

RUN groupadd --gid 1002 yashigani-kuroshio \
    && useradd --uid 1002 --gid 1002 --no-create-home --shell /bin/false yashigani-kuroshio

RUN apt-get update \
    && apt-get -y --no-install-recommends install python3.12-minimal \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=artifact /artifact/llama-server /usr/local/bin/llama-server
COPY --from=artifact /artifact/*.so /usr/local/lib/
RUN ldconfig
COPY --from=wheel-builder /dist/*.whl /tmp/
RUN pip3 install --no-cache-dir --break-system-packages /tmp/*.whl \
    && rm -f /tmp/*.whl

COPY infer/deploy/docker/entrypoint/kuroshio-entrypoint.sh /usr/local/bin/kuroshio-entrypoint.sh
RUN chmod 0555 /usr/local/bin/kuroshio-entrypoint.sh /usr/local/bin/llama-server \
    && mkdir -p /data/model-store /data/scratch \
    && chown -R yashigani-kuroshio:yashigani-kuroshio /data

USER yashigani-kuroshio
EXPOSE 8000
ENV YSG_KUROSHIO_BACKEND=cpu \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONNOUSERSITE=1

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD /usr/local/bin/kuroshio-entrypoint.sh --healthcheck || exit 1

ARG GIT_SHA=dev
LABEL org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.licenses="Apache-2.0 AND MIT" \
      yashigani.kuroshio.backend="cpu"

ENTRYPOINT ["/usr/local/bin/kuroshio-entrypoint.sh"]
